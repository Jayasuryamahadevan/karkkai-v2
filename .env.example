# Chillian configuration
# Copy this file to .env and uncomment/add keys when you want optional engines.

# Host and port for the local server
HOST=127.0.0.1
PORT=8787

# auto | bing | mymemory | sarvam
TRANSLATION_ENGINE=auto

# The default engine is Bing Translator, which needs no account or key.
# MyMemory is the free fallback. Both work without any sign-in.

# Optional: lets MyMemory raise its free quota when you supply an email
MYMEMORY_EMAIL=

# Optional: Sarvam AI adds translation, Tamil text-to-speech and uploaded-audio
# speech-to-text. Free keys are available at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# Optional: server-side uploaded-audio transcription through OpenAI Whisper
OPENAI_API_KEY=

# Limits (MB / characters / pages)
MAX_TRANSLATE_CHARS=5000
MAX_TTS_CHARS=4500
MAX_PDF_MB=30
MAX_AUDIO_MB=25
MAX_PDF_PAGES=80
PDF_SESSION_MINUTES=180
PDF_TIMEOUT=150
